package docs:adder@0.1.3;

world adder {
  import zlib;
  import lua-callback;
  @unstable(feature = postgres-read-context)
  import experimental-read;

  include tarantool:tarantool/guest@0.2.0;

  import wasi:cli/environment@0.2.3;
  import wasi:cli/exit@0.2.3;
  import wasi:io/error@0.2.3;
  import wasi:io/poll@0.2.3;
  import wasi:io/streams@0.2.3;
  import wasi:cli/stdin@0.2.3;
  import wasi:cli/stdout@0.2.3;
  import wasi:cli/stderr@0.2.3;
  import wasi:cli/terminal-input@0.2.3;
  import wasi:cli/terminal-output@0.2.3;
  import wasi:cli/terminal-stdin@0.2.3;
  import wasi:cli/terminal-stdout@0.2.3;
  import wasi:cli/terminal-stderr@0.2.3;
  import wasi:clocks/monotonic-clock@0.2.3;
  import wasi:clocks/wall-clock@0.2.3;
  import wasi:filesystem/types@0.2.3;
  import wasi:filesystem/preopens@0.2.3;
  import wasi:sockets/network@0.2.3;
  import wasi:sockets/instance-network@0.2.3;
  import wasi:sockets/udp@0.2.3;
  import wasi:sockets/udp-create-socket@0.2.3;
  import wasi:sockets/tcp@0.2.3;
  import wasi:sockets/tcp-create-socket@0.2.3;
  import wasi:sockets/ip-name-lookup@0.2.3;
  import wasi:random/random@0.2.3;
  import wasi:random/insecure@0.2.3;
  import wasi:random/insecure-seed@0.2.3;

  import wasi:http/types@0.2.3;
  import wasi:http/outgoing-handler@0.2.3;

  import wasi:tls/types@0.2.0-draft;

  export wasi:http/incoming-handler@0.2.3;

  export wasi:cli/run@0.2.3;
}

interface zlib {
  compress: func(data: list<u8>, level: u32) -> list<u8>;
  decompress: func(data: list<u8>) -> list<u8>;
  crc32: func(data: list<u8>) -> u32;
  adler32: func(data: list<u8>) -> u32;
}

/// Calls Lua closures registered by the embedding Tarantool application.
/// Request and response values use MessagePack to preserve Lua value types.
interface lua-callback {
  resource handler {
    call: func(payload: list<u8>) -> result<list<u8>, string>;
  }

  /// Creates a stable guest handle. The Lua closure is resolved by name on
  /// every call, so registration and replacement remain dynamic.
  open: func(name: string) -> result<handler, string>;
}

/// Experimental statement-scoped snapshot reads for PostgreSQL guests.
/// Successful open fixes a committed snapshot before returning, independently
/// of the first get, count, select, or iterator.next call. Close it after one
/// SQL statement. If the host cannot represent every accessible user space
/// and index in that snapshot, open fails with a box-error whose message
/// starts with "snapshot unavailable:". Guests must abort the statement on
/// this error, not fall back to ordinary reads. In particular, application
/// read views on the tested Tarantool build omit Vinyl spaces.
/// The context exposes only committed data. A PostgreSQL guest must overlay
/// its own uncommitted INSERT/UPDATE/DELETE for read-your-writes semantics.
/// Host writes and COMMIT can still fail on a Tarantool MVCC conflict.
interface experimental-read {
  use tarantool:tarantool/types@0.2.0.{box-error, box-tuple, space, index, iterator-type};

  resource read-context {
    close: func() -> result<_, box-error>;
  }

  open: func() -> result<read-context, box-error>;
  space-by-name: func(ctx: borrow<read-context>, name: string) -> result<option<space>, box-error>;
  index-by-name: func(ctx: borrow<read-context>, space: space, name: string) -> result<option<index>, box-error>;
  get: func(ctx: borrow<read-context>, index: index, key: list<u8>) -> result<option<box-tuple>, box-error>;
  count: func(ctx: borrow<read-context>, index: index, mode: iterator-type, key: list<u8>) -> result<u64, box-error>;
  select: func(ctx: borrow<read-context>, index: index, mode: iterator-type, key: list<u8>) -> result<iterator, box-error>;

  resource iterator {
    next: func(ctx: borrow<read-context>) -> result<option<box-tuple>, box-error>;
  }
}
