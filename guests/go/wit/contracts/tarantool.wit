package tarantool:tarantool@0.2.0;

@since(version = 0.2.0)
interface metrics {
  /// Returns the current uptime of the instance in seconds.
  ///
  /// Corresponds to `box.info.uptime`.
  ///
  /// ### Returns
  /// - Uptime in seconds as a floating-point value (`f64`).
  @since(version = 0.2.0)
  uptime: func() -> f64;
}

@since(version = 0.2.0)
interface types {
  /// Exactly one complete MessagePack value encoded as bytes.
  ///
  /// The byte sequence must contain one value and no trailing bytes. Functions
  /// further constrain its shape where required, for example to an array or a
  /// map. Values returned by the host are copied into guest-owned memory.
  @since(version = 0.2.0)
  type msgpack-value = list<u8>;

  /// Numeric Tarantool error code.
  ///
  /// This is the original unsigned code reported by Tarantool, including codes
  /// unknown to this version of the WIT package. Consumers must preserve and
  /// accept any `u32` value. Symbolic `ER_*` names belong to the Tarantool
  /// version that produced the error and are not part of this contract.
  @since(version = 0.2.0)
  type error-code = u32;

  /// Represents an error returned by Tarantool operations.
  ///
  /// The numeric code is preserved exactly as reported by Tarantool. Consumers
  /// must handle codes they do not recognize. No closed error category is
  /// included because Tarantool's error set and classifications may evolve.
  @since(version = 0.2.0)
  record box-error {
    /// Raw IPROTO or internal Tarantool error code.
    code: error-code,
    /// Human-readable error message.
    message: string,
    /// Host-provided error type, for example "ClientError" or "SocketError".
    error-type: string,
    /// Source file where the error originated (if available).
    file: option<string>,
    /// Line number in the source file where the error was raised.
    line: option<u32>,
  }

  /// Identifies a Tarantool space by its numeric ID.
  @since(version = 0.2.0)
  record space {
    /// Unique identifier of the space.
    id: u32,
  }

  /// Identifies a Tarantool index and its parent space.
  @since(version = 0.2.0)
  record index {
    /// Index ID within its parent space.
    id: u32,
    /// Numeric ID of the parent space.
    space-id: u32,
  }

  /// Optional guest source location attached to a log message.
  @since(version = 0.2.0)
  record log-context {
    /// Name of the source file generating the log.
    file: string,
    /// Line number in the source file generating the log.
    line: u32,
  }

  /// Defines the severity levels used in Tarantool logging.
  ///
  /// See <https://www.tarantool.io/en/doc/latest/reference/reference_capi/say/>.
  @since(version = 0.2.0)
  enum log-level {
    /// Recoverable error.
    error,
    /// Severe error.
    critical,
    /// Warning.
    warning,
    /// Informational message.
    info,
    /// Verbose message.
    verbose,
    /// Debug-level message.
    debug,
  }

  /// Represents a client session in Tarantool by its ID.
  @since(version = 0.2.0)
  record session {
    /// Unique session identifier.
    id: u64,
  }

  /// Isolation levels available for Tarantool transactions.
  @since(version = 0.2.0)
  enum transaction-isolation {
    /// Use Tarantool's configured default isolation level.
    default,
    /// Let Tarantool choose the isolation level for the transaction.
    best-effort,
    /// Read only committed, but not unconfirmed changes.
    read-committed,
    /// Read only confirmed changes.
    read-confirmed,
    /// Read only changes confirmed on any cluster node.
    linearizable,
  }

  /// Iterator types for index scans in Tarantool.
  ///
  /// See <https://www.tarantool.io/en/doc/latest/reference/reference_capi/box_index/>.
  @since(version = 0.2.0)
  enum iterator-type {
    /// Equal.
    equal,
    /// Reverse equal.
    reverse-equal,
    /// Full scan (all tuples).
    all,
    /// Less than.
    less-than,
    /// Less than or equal.
    less-than-or-equal,
    /// Greater than or equal.
    greater-than-or-equal,
    /// Greater than.
    greater-than,
    /// Bitmask: all bits set.
    bits-all-set,
    /// Bitmask: any bit set.
    bits-any-set,
    /// Bitmask: all bits not set.
    bits-all-not-set,
    /// Range overlaps.
    overlaps,
    /// Spatial index neighbor.
    neighbor,
    /// Next prefix in ascending order.
    next-prefix,
    /// Previous prefix in descending order.
    previous-prefix,
  }

  /// Identifies a sequence that already exists in Tarantool.
  ///
  /// The WIT interface changes sequence state but does not create schema
  /// objects. See
  /// <https://www.tarantool.io/en/doc/latest/platform/ddl_dml/sequences/>.
  @since(version = 0.2.0)
  record sequence {
    /// Numeric identifier of the sequence in Tarantool.
    id: u32,
  }

  /// Flags used to modify behavior of key parts in index definitions.
  @since(version = 0.2.0)
  flags key-part-flags {
    /// Allows NULL values in this key part.
    is-nullable,
    /// Exclude NULL values when comparing key parts.
    exclude-null,
  }

  /// Built-in Tarantool collation identifiers supported by this contract.
  ///
  /// Case ordinals correspond to the built-in IDs in Tarantool's `_collation`
  /// system space. User-defined collations are outside this closed enum.
  @since(version = 0.2.0)
  enum collation {
    none,
    /// 0
    unicode,
    /// 1
    unicode-ci,
    /// 2
