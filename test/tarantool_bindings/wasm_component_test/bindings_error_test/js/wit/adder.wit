package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/error@0.2.0;
  use tarantool:tarantool/types@0.2.0.{box-error, error-code};

  export t-new: func(code: error-code, message: string) -> box-error;
  export t-new-with-location: func(code: error-code, message: string, file: option<string>, line: option<u32>) -> box-error;
  export t-set: func(err: box-error);
  export t-last: func() -> option<box-error>;
  export t-clear: func();
  export t-to-string: func(err: box-error) -> string;
}
