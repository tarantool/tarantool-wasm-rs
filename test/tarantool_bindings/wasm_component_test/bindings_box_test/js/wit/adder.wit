package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/database@0.2.0;
  import tarantool:tarantool/box-tuple@0.2.0;
  use tarantool:tarantool/types@0.2.0.{space, box-error, index, msgpack-value};

  export t-schema-version: func() -> u32;
  export t-space-by-name: func(name: string) -> result<option<space>, box-error>;
  export t-index-by-name: func(space: space, name: string) -> result<option<index>, box-error>;
  export t-insert: func(space: space, tup: msgpack-value) -> result<msgpack-value, box-error>;
  export t-update: func(index: index, key: msgpack-value, ops: msgpack-value) -> result<option<msgpack-value>, box-error>;
  export t-replace: func(space: space, tup: msgpack-value) -> result<msgpack-value, box-error>;
  export t-upsert: func(index: index, tup: msgpack-value, ops: msgpack-value) -> result<_, box-error>;
  export t-delete: func(index: index, key: msgpack-value) -> result<option<msgpack-value>, box-error>;
  export t-truncate: func(space: space) -> result<_, box-error>;
}
