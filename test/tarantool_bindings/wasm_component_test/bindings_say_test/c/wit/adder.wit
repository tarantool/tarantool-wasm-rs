package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/log@0.2.0;
  use tarantool:tarantool/types@0.2.0.{log-level, log-context};

  export t-say: func(level: log-level, msg: string, ctx: option<log-context>);
  export t-say-error: func(msg: string, ctx: option<log-context>);
  export t-say-crit: func(msg: string, ctx: option<log-context>);
  export t-say-warn: func(msg: string, ctx: option<log-context>);
  export t-say-info: func(msg: string, ctx: option<log-context>);
  export t-say-verbose: func(msg: string, ctx: option<log-context>);
  export t-say-debug: func(msg: string, ctx: option<log-context>);
}
