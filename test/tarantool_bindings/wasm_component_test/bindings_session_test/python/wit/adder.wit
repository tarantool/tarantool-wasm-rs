package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/session@0.2.0;
  use tarantool:tarantool/types@0.2.0.{session, box-error, msgpack-value};

  export t-current: func() -> session;
  export t-broadcast: func(key: string, value: string) -> result<_, box-error>;
  export t-iproto-send: func(session: session, header: msgpack-value, body: option<msgpack-value>) -> result<_, box-error>;
}
