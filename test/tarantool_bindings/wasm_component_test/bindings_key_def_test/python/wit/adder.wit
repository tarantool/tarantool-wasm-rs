package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/msgpack@0.2.0;
  import tarantool:tarantool/key-def@0.2.0;
  import tarantool:tarantool/box-tuple@0.2.0;
  use tarantool:tarantool/types@0.2.0.{box-error, box-tuple, key-def, key-part, msgpack-value};

  export t-tuple-new: func(data: msgpack-value) -> result<box-tuple, box-error>;
  export t-new: func(parts: list<key-part>) -> result<key-def, box-error>;
  export t-duplicate: func(key-def: key-def) -> result<key-def, box-error>;
  export t-merge: func(left: key-def, right: key-def) -> result<key-def, box-error>;
  export t-release: func(key-def: key-def);
  export t-dump-parts: func(key-def: key-def) -> result<list<key-part>, box-error>;
  export t-validate-key: func(key-def: key-def, key: msgpack-value) -> result<_, box-error>;
  export t-validate-full-key: func(key-def: key-def, key: msgpack-value) -> result<_, box-error>;
  export t-part-count: func(key-def: key-def) -> result<u32, box-error>;
  export t-extract-key: func(key-def: key-def, %tuple: box-tuple) -> result<msgpack-value, box-error>;
  export t-validate-tuple: func(key-def: key-def, %tuple: box-tuple) -> result<_, box-error>;
}
