package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/index@0.2.0;
  import tarantool:tarantool/box-tuple@0.2.0;
  use tarantool:tarantool/types@0.2.0.{index, box-error, iterator-type, msgpack-value};

  export t-len: func(index: index) -> result<u64, box-error>;
  export t-bsize: func(index: index) -> result<u64, box-error>;
  export t-random: func(index: index, rnd: u32) -> result<option<msgpack-value>, box-error>;
  export t-get: func(index: index, key: msgpack-value) -> result<option<msgpack-value>, box-error>;
  export t-min: func(index: index, key: msgpack-value) -> result<option<msgpack-value>, box-error>;
  export t-max: func(index: index, key: msgpack-value) -> result<option<msgpack-value>, box-error>;
  export t-count: func(index: index, iter-type: iterator-type, key: msgpack-value) -> result<u64, box-error>;
}
