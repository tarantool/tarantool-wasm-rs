package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/sequence@0.2.0;
  import tarantool:tarantool/log@0.2.0;
  use tarantool:tarantool/types@0.2.0.{sequence, box-error};

  export t-next: func(seq: sequence) -> result<s64, box-error>;
  export t-current: func(seq: sequence) -> result<s64, box-error>;
  export t-set: func(seq: sequence, value: s64) -> result<_, box-error>;
  export t-reset: func(seq: sequence) -> result<_, box-error>;
}
