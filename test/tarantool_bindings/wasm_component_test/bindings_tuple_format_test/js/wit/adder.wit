package docs:adder@0.1.0;

world adder {
  import tarantool:tarantool/types@0.2.0;
  import tarantool:tarantool/key-def@0.2.0;
  import tarantool:tarantool/tuple-format@0.2.0;
  use tarantool:tarantool/types@0.2.0.{key-def, box-error, tuple-format, key-part};

  export t-default: func() -> tuple-format;
  export t-new: func(key-defs: list<key-def>) -> result<tuple-format, box-error>;
  export t-ref: func(tf: tuple-format);
  export t-unref: func(tf: tuple-format);
  export t-key-def-new: func(parts: list<key-part>) -> result<key-def, box-error>;
}
