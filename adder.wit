package docs:adder@0.1.0;

world adder {
  import types;
  import msgpack;
  import ttbox;
  import say;
  import error;
  import session;
  import txn;
  import index;
  import sequence;
  import key-def;
  import tuple-format;
  import %tuple;

  import wasi:cli/environment@0.2.0;
  import wasi:cli/exit@0.2.0;
  import wasi:io/error@0.2.0;
  import wasi:io/poll@0.2.0;
  import wasi:io/streams@0.2.0;
  import wasi:cli/stdin@0.2.0;
  import wasi:cli/stdout@0.2.0;
  import wasi:cli/stderr@0.2.0;
  import wasi:cli/terminal-input@0.2.0;
  import wasi:cli/terminal-output@0.2.0;
  import wasi:cli/terminal-stdin@0.2.0;
  import wasi:cli/terminal-stdout@0.2.0;
  import wasi:cli/terminal-stderr@0.2.0;
  import wasi:clocks/monotonic-clock@0.2.0;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:filesystem/types@0.2.0;
  import wasi:filesystem/preopens@0.2.0;
  import wasi:sockets/network@0.2.0;
  import wasi:sockets/instance-network@0.2.0;
  import wasi:sockets/udp@0.2.0;
  import wasi:sockets/udp-create-socket@0.2.0;
  import wasi:sockets/tcp@0.2.0;
  import wasi:sockets/tcp-create-socket@0.2.0;
  import wasi:sockets/ip-name-lookup@0.2.0;
  import wasi:random/random@0.2.0;
  import wasi:random/insecure@0.2.0;
  import wasi:random/insecure-seed@0.2.0;

  export wasi:cli/run@0.2.0;
}

interface types {

    record box-error {
        message: string,
        %type: string,
        code: u32,
        payload: option<list<tuple<string, string>>>,
        file: option<string>,
        line: option<u32>,
    }

    record space {
        id: s32,
    }

    record index {
        id: s32,
        space-id: s32,
        index-base: s32,
    }

    type box-tuple = u64;

    enum log-level {
        s-fatal,
        s-syserror,
        s-error,
        s-crit,
        s-warn,
        s-info,
        s-verbose,
        s-debug,
    }

    record session {
        id: s64,
    }

    enum txn-isolation-level {
      /** take isolation level from global default_isolation_level. */
      txn-isolation-default,
      /** determine isolation level automatically (default). */
      txn-isolation-best-effort,
      /** allow to read committed, but not confirmed changes. */
      txn-isolation-read-committed,
      /** allow to read only confirmed changes. */
      txn-isolation-read-confirmed,
      /** allow to read only the changes confirmed on any cluster node. */
      txn-isolation-linearizable,
    }

    enum iterator-type {
      iter-eq,
      iter-req,
      iter-all,
      iter-lt,
      iter-le,
      iter-ge,
      iter-gt,
      iter-bits-all-set,
      iter-bits-any-set,
      iter-bits-all-not-set,
      iter-overlaps,
      iter-neighbor,
      iter-np,
      iter-pp,
    }

    resource iterator {
      new-iterator: static func(index: index, iterator-type: iterator-type, key: list<u8>) -> result<iterator, box-error>;
      next: func() -> result<box-tuple, box-error>;
    }

    record sequence {
        id: s32,
    }

    flags key-part-flags {
      is-nullable,
      exclude-null,
    }

    record key-part {
        field-no: u32,
        field-type: string,
        collation: option<string>,
        path: option<string>,
        %flags: key-part-flags,
    }

    type key-def = u64;
    type tuple-format = u64;
    type tuple-field = u64;
    type raw-ptr = u64;
}

interface msgpack {
  use types.{
    box-error,
    raw-ptr,
  };

  /// Encodes a JSON-like structure into MsgPack format.
  ///
  /// This function accepts a UTF-8 encoded JSON string (as a byte array)
  /// and returns the equivalent data in MessagePack format.
  ///
  /// ### Parameters
  /// - `data`: A byte array containing a valid UTF-8 encoded JSON string.
  ///
  /// ### Returns
  /// - A byte array containing the same structure encoded in MessagePack format.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import msgpack
  /// import json
  ///
  /// obj = {"key": "value", "num": 123}
  /// json_bytes = json.dumps(obj).encode('utf-8')
  /// encoded_obj = msgpack.encode(json_bytes)
  /// ```
  ///
  /// **JavaScript**
  /// ```js
  /// import { encode } from 'docs:adder/msgpack@0.1.0';
  ///
  /// const obj = { key: "value", num: 123 };
  /// const jsonString = JSON.stringify(obj);
  /// const jsonBytes = new TextEncoder().encode(jsonString);
  /// const encodedObj = await encode(jsonBytes);
  /// ```
  encode: func(data: list<u8>) -> result<list<u8>, box-error>;

  /// Decodes a MsgPack-encoded byte array back into a JSON-like structure.
  ///
  /// This function takes a byte array containing data in MessagePack format
  /// and returns a UTF-8 encoded JSON string as a byte array. You can then
  /// decode the string and parse it into a native data structure.
  ///
  /// ### Parameters
  /// - `data`: A byte array containing data encoded in MessagePack format.
  ///
  /// ### Returns
  /// - A byte array containing a UTF-8 encoded JSON string.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import msgpack
  /// import json
  ///
  /// msgpack_bytes: bytes = ...
  /// decoded_json_bytes: bytes = msgpack.decode(msgpack_bytes)
  /// decoded_json_string = decoded_json_bytes.decode('utf-8')
  /// obj = json.loads(decoded_json_string)
  /// ```
  ///
  /// **JavaScript**
  /// ```js
  /// import { decode } from 'docs:adder/msgpack@0.1.0';
  ///
  /// const msgPackBytes = ...; // Uint8Array
  /// const decodedJsonBytes = await decode(msgPackBytes);
  /// const decodedJsonString = new TextDecoder().decode(decodedJsonBytes);
  /// const obj = JSON.parse(decodedJsonString);
  /// ```
  decode: func(data: list<u8>) -> result<list<u8>, box-error>;

  /// Decodes a MsgPack-encoded value from a raw pointer into a JSON-like structure.
  ///
  /// This function is used when the MsgPack data is already located in memory
  /// (e.g. returned from a low-level API) and referenced via a raw pointer.
  /// It reads the value starting at the given pointer and returns a UTF-8 encoded
  /// JSON string as a byte array.
  ///
  /// ### Parameters
  /// - `ptr`: A raw pointer (`u64`) to the beginning of the MsgPack-encoded value.
  ///
  /// ### Returns
  /// - A byte array containing a UTF-8 encoded JSON string.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import msgpack
  /// import json
  ///
  /// ptr: int = ...  # obtained from low-level API
  /// decoded_json_bytes: bytes = msgpack.decode_from_raw_ptr(ptr)
  /// decoded_json_string = decoded_json_bytes.decode('utf-8')
  /// obj = json.loads(decoded_json_string)
  /// ```
  ///
  /// **JavaScript**
  /// ```js
  /// import { decodeFromRawPtr } from 'docs:adder/msgpack@0.1.0';
  ///
  /// const ptr = ...; // e.g. returned from an iterator
  /// const decodedJsonBytes = await decodeFromRawPtr(ptr);
  /// const decodedJsonString = new TextDecoder().decode(decodedJsonBytes);
  /// const obj = JSON.parse(decodedJsonString);
  /// ```
  decode-from-raw-ptr: func(ptr: raw-ptr) -> result<list<u8>, box-error>;
}

interface ttbox {

  use types.{
      space,
      box-error,
      index,
      box-tuple
  };

  /// Returns the current schema version of the database.
  ///
  /// The schema version increases whenever the schema changes, such as creating or dropping spaces or indexes.
  ///
  /// ### Returns
  /// - A 64-bit integer representing the current schema version.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  ///
  /// version = box.schema_version()
  /// print("Schema version:", version)
  /// ```
  schema-version: func() -> s64;


  /// Retrieves a space object by its name.
  ///
  /// This function performs a lookup for a space by name and returns a reference used in subsequent operations.
  ///
  /// ### Parameters
  /// - `name`: The name of the space to retrieve.
  ///
  /// ### Returns
  /// - A space object if found, or an error otherwise.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  ///
  /// space = box.space_by_name("test_space")
  /// print("Space ID:", space.id)
  /// ```
  space-by-name: func(name: string) -> result<space, box-error>;


  /// Retrieves an index object by name within a space.
  ///
  /// This function looks up the specified index in the given space and returns a reference to it.
  ///
  /// ### Parameters
  /// - `space`: The space to search within.
  /// - `name`: The name of the index to retrieve.
  ///
  /// ### Returns
  /// - An index object if found, or an error otherwise.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  ///
  /// index = box.index_by_name(space, "primary")
  /// print("Index ID:", index.id)
  /// ```
  index-by-name: func(%space: space, name: string) -> result<index, box-error>;


  /// Inserts a new tuple into a space.
  ///
  /// The tuple must be provided as a MsgPack-encoded array: `[field1, field2, ...]`.
  ///
  /// ### Parameters
  /// - `space`: The target space.
  /// - `tup`: A MsgPack-encoded array representing the tuple.
  ///
  /// ### Returns
  /// - The inserted tuple.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  /// from adder.imports import tuple as tt_tuple
  /// from adder.imports import msgpack
  ///
  /// tup_bytes = msgpack.encode([1, "Alice", 25])
  /// inserted = box.insert(space, tup_bytes)
  /// print("Inserted ptr: ", hex(inserted))
  /// print("Inserted tuple: ", msgpack.decode(tt_tuple.to_buf(inserted)))
  /// ```
  insert: func(space: space, tup: list<u8>) -> result<box-tuple, box-error>;


  /// Updates an existing tuple by key in the specified index.
  ///
  /// - `key` must be a MsgPack array identifying the tuple, e.g. `[1]`
  /// - `ops` must be a MsgPack array of operations, e.g. `[[ "=", 2, 30 ]]`
  ///
  /// ### Parameters
  /// - `index`: The index to use for locating the tuple.
  /// - `key`: MsgPack-encoded key array.
  /// - `ops`: MsgPack-encoded array of update operations.
  ///
  /// ### Returns
  /// - The updated tuple.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  /// from adder.imports import tuple as tt_tuple
  /// from adder.imports import msgpack
  ///
  /// key = msgpack.encode([1])
  /// ops = msgpack.encode([["=", 2, 26]])
  /// updated = box.update(index, key, ops)
  /// print("Updated ptr: ", hex(updated))
  /// print("Updated tuple: ", msgpack.decode(tt_tuple.to_buf(updated)))
  /// ```
  update: func(index: index, key: list<u8>, ops: list<u8>) -> result<box-tuple, box-error>;


  /// Replaces an existing tuple or inserts a new one.
  ///
  /// ### Parameters
  /// - `space`: The space to operate on.
  /// - `tup`: A MsgPack-encoded array representing the new tuple.
  ///
  /// ### Returns
  /// - The replaced tuple.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  /// from adder.imports import tuple as tt_tuple
  /// from adder.imports import msgpack
  ///
  /// tup = msgpack.encode([2, "Bob Jr.", 31])
  /// replaced = box.replace(space, tup)
  /// print("Replaced ptr: ", hex(replaced))
  /// print("Replaced tuple: ", decode(data=tt_tuple.to_buf(replaced)))
  /// ```
  replace: func(space: space, tup: list<u8>) -> result<box-tuple, box-error>;


  /// Performs an UPSERT operation: update if exists, insert otherwise.
  ///
  /// ### Parameters
  /// - `index`: The index used for key lookup.
  /// - `tup`: A MsgPack-encoded tuple to insert.
  /// - `ops`: A MsgPack-encoded array of update operations.
  ///
  /// ### Returns
  /// - The previous version of the tuple if it existed; otherwise, `null` if inserted.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  /// from adder.imports import msgpack
  ///
  /// tup = msgpack.encode([6, "Frank", 50])
  /// ops = msgpack.encode([["+", 2, 1]])
  /// box.upsert(index, tup, ops)
  /// ```
  upsert: func(index: index, tup: list<u8>, ops: list<u8>) -> result<box-tuple, box-error>;


  /// Deletes a tuple by key from the specified index.
  ///
  /// The key must be encoded as a MsgPack array, e.g. `[1]`.
  ///
  /// ### Parameters
  /// - `index`: The index used for key lookup.
  /// - `key`: MsgPack-encoded key array.
  ///
  /// ### Returns
  /// - The deleted tuple, if found.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  /// from adder.imports import tuple as tt_tuple
  /// from adder.imports import msgpack
  ///
  /// deleted = box.tt_delete(index, msgpack.encode([3]))
  /// print("Deleted ptr: ", hex(deleted))
  /// print("Deleted tuple: ", msgpack.decode(data=tt_tuple.to_buf(deleted)))
  /// ```
  tt-delete: func(index: index, key: list<u8>) -> result<box-tuple, box-error>;


  /// Removes all tuples from the space.
  ///
  /// This operation is equivalent to SQL's `TRUNCATE TABLE`.
  ///
  /// ### Parameters
  /// - `space`: The target space to truncate.
  ///
  /// ### Returns
  /// - `null` on success, or an error.
  ///
  /// ### Examples
  ///
  /// **Python**
  /// ```python
  /// from adder.imports import ttbox as box
  ///
  /// box.truncate(space)
  /// print("Space cleared")
  /// ```
  truncate: func(space: space) -> result<_, box-error>;
}

interface say {

    use types.{
        log-level,
    };

    say: func(level: log-level, msg: string);
    say-error: func(msg: string);
    say-crit: func(msg: string);
    say-warn: func(msg: string);
    say-info: func(msg: string);
    say-verbose: func(msg: string);
    say-debug: func(msg: string);
    say-syserror: func(msg: string);
}

interface error {

    use types.{
        box-error,
    };

    error-new: func(message: string, %type: string, code: u32) -> box-error;
    set: func(err: box-error);
    last: func() -> option<box-error>;
    clear: func();
    to-string: func(err: box-error) -> string;

}

interface session {

  use types.{
      session,
      box-error,
  };

  // C API: uint64_t box_session_id(void)
  // https://www.tarantool.io/en/doc/latest/reference/reference_capi/box/#c.box_session_id
  current: func() -> session;

  // Lua API: box.broadcast(key, value)
  // https://www.tarantool.io/en/doc/latest/reference/reference_lua/box_events/broadcast/#lua-function.box.broadcast
  //
  // Now you can pass any lua object using a string.
  // Example: broadcast("x", "{a = 2, [2] = 3}")
  broadcast: func(key: string, value: string) -> result<_, box-error>;

  // C API: int box_iproto_send(uint64_t sid, char *header, char *header_end[, char *body, char *body_end])
  // https://www.tarantool.io/en/doc/latest/reference/reference_capi/box/#c.box_iproto_send
  iproto-send: func(session: session, header: list<u8>, body: list<u8>) -> result<_, box-error>;

}

interface txn {

  use types.{
      box-error,
      txn-isolation-level,
  };

  /// Returns the current transaction ID.
  ///
  /// Transaction id - a non-persistent unique identifier
  /// of the current transaction. -1 if there is no current
  /// transaction.
  /// C API: int64_t box_txn_id(void)
  /// No doc
  txn-id: func() -> s64;

  /// Returns the current transaction isolation level.
  ///
  /// Get isolation level of current transaction, one of enum txn_isolation_level
  /// values (but cannot be TXN_ISOLATION_DEFAULT (which is zero) by design).
  /// -1 if there is no current transaction.
  /// C API: int box_txn_isolation(void);
  /// No doc
  txn-isolation: func() -> txn-isolation-level;

  /// Return true if there is an active transaction.
  ///
  /// C API: bool box_txn(void)
  /// https://www.tarantool.io/en/doc/latest/reference/reference_capi/txn/#c.box_txn
  txn: func() -> bool;

  /// Begins a new transaction.
  ///
  /// If an error occurs, it returns `BoxError` from `box_error_last()`.
  /// Implemented using `box_txn_begin()` from Tarantool C API.
  begin: func() -> result<_, box-error>;

  /// Commits the current transaction.
  ///
  /// If an error occurs, it returns `BoxError` from `box_error_last()`.
  /// Implemented using `box_txn_commit()` from the Tarantool C API.
  commit: func() -> result<_, box-error>;

  /// Rolls back the current transaction.
  ///
  /// If an error occurs, it returns `BoxError` from `box_error_last()`.
  /// Implemented using `box_txn_rollback()` from the Tarantool C API.
  rollback: func() -> result<_, box-error>;

  /// Set an isolation @a level for a transaction.
  /// Must be called before the first DML.
  /// The level must be of enun txn_isolation_level values.
  /// @retval 0 if success
  /// @retval -1 if failed, diag is set.
  ///
  /// C API: int box_txn_set_isolation(uint32_t level)
  /// No doc
  txn-set-isolation: func(isolation: txn-isolation-level) -> result<_, box-error>;

  /// Make the transaction synchronous.
  ///
  /// C API void box_txn_make_sync(void)
  /// No doc
  txn-make-sync: func();

}

interface index {
  use types.{
      index,
      box-error,
      box-tuple,
      iterator-type,
  };

  len: func(index: index) -> result<s64, box-error>;
  bsize: func(index: index) -> result<s64, box-error>;
  random: func(index: index, rnd: u32) -> result<box-tuple, box-error>;
  get: func(index: index, key: list<u8>) -> result<box-tuple, box-error>;
  min: func(index: index, key: list<u8>) -> result<box-tuple, box-error>;
  max: func(index: index, key: list<u8>) -> result<box-tuple, box-error>;
  count: func(index: index, iter-type: iterator-type, key: list<u8>) -> result<s64, box-error>;

}

interface sequence {
  use types.{
      sequence,
      box-error,
  };

  next: func(seq: sequence) -> result<s64, box-error>;
  current: func(seq: sequence) -> result<s64, box-error>;
  set: func(seq: sequence, value: s64) -> result<_, box-error>;
  reset: func(seq: sequence) -> result<_, box-error>;
}


interface key-def {

  use types.{
      box-error,
      box-tuple,
      key-def,
      key-part,
  };

  new: func(parts: list<key-part>) -> result<key-def, box-error>;
  delete: func(key-def: key-def);
  merge: func(left: key-def, right: key-def) -> result<key-def, box-error>;
  dup: func(key-def: key-def) -> result<key-def, box-error>;
  dump-parts: func(key-def: key-def) -> result<list<key-part>, box-error>;
  validate-key: func(key-def: key-def, key: list<u8>) -> result<tuple<bool, u32>, box-error>;
  validate-full-key: func(key-def: key-def, key: list<u8>) -> result<tuple<bool, u32>, box-error>;
  part-count: func(key-def: key-def) -> result<u32, box-error>;
  extract-key: func(key-def: key-def, %tuple: box-tuple) -> box-tuple;
  validate-tuple: func(key-def: key-def, %tuple: box-tuple) -> bool;

}

interface tuple-format {
  use types.{
      key-def,
      box-error,
      tuple-format
  };

  default: func() -> tuple-format;
  new: func(key-defs: list<key-def>) -> result<tuple-format, box-error>;
  ref: func(tf: tuple-format);
  unref: func(tf: tuple-format);
}

interface %tuple {

  use types.{
      box-error,
      box-tuple,
      tuple-field,
      tuple-format,
      key-def,
  };

  new: func(format: tuple-format, data: list<u8>) -> result<box-tuple, box-error>;
  ref: func(t: box-tuple) -> s32;
  unref: func(t: box-tuple);
  field-count: func(t: box-tuple) -> u32;
  bsize: func(t: box-tuple) -> u64;
  to-buf: func(t: box-tuple) -> result<list<u8>, box-error>;
  format: func(t: box-tuple) -> tuple-format;
  field: func(t: box-tuple, idx: u32) -> result<tuple-field, box-error>;
  field-by-path: func(t: box-tuple, path: string, index-base: s32) -> result<tuple-field, box-error>;
  update: func(t: box-tuple, expr: list<u8>) -> result<box-tuple, box-error>;
  upsert: func(t: box-tuple, expr: list<u8>) -> result<box-tuple, box-error>;
  validate: func(t: box-tuple, format: tuple-format) -> bool;
  compare-with-key: func(%tuple: box-tuple, key: list<u8>, key-def: key-def) -> s32;
  compare: func(key-def: key-def, left: box-tuple, right: box-tuple) -> s32;

  resource tuple-iterator {
    new-tuple-iterator: static func(%tuple: box-tuple) -> result<tuple-iterator, box-error>;
    position: func() -> u32;
    rewind: func();
    seek: func(pos: u32) -> result<tuple-field, box-error>;
    next: func() -> result<tuple-field, box-error>;
  }
}

// =================================================================================================


package wasi:io@0.2.0 {
  interface error {
    resource error {
      to-debug-string: func() -> string;
    }
  }
  interface poll {
    resource pollable {
      ready: func() -> bool;
      block: func();
    }

    poll: func(in: list<borrow<pollable>>) -> list<u32>;
  }
  interface streams {
    use error.{error};
    use poll.{pollable};

    variant stream-error {
      last-operation-failed(error),
      closed,
    }

    resource input-stream {
      read: func(len: u64) -> result<list<u8>, stream-error>;
      blocking-read: func(len: u64) -> result<list<u8>, stream-error>;
      skip: func(len: u64) -> result<u64, stream-error>;
      blocking-skip: func(len: u64) -> result<u64, stream-error>;
      subscribe: func() -> pollable;
    }

    resource output-stream {
      check-write: func() -> result<u64, stream-error>;
      write: func(contents: list<u8>) -> result<_, stream-error>;
      blocking-write-and-flush: func(contents: list<u8>) -> result<_, stream-error>;
      flush: func() -> result<_, stream-error>;
      blocking-flush: func() -> result<_, stream-error>;
      subscribe: func() -> pollable;
      write-zeroes: func(len: u64) -> result<_, stream-error>;
      blocking-write-zeroes-and-flush: func(len: u64) -> result<_, stream-error>;
      splice: func(src: borrow<input-stream>, len: u64) -> result<u64, stream-error>;
      blocking-splice: func(src: borrow<input-stream>, len: u64) -> result<u64, stream-error>;
    }
  }
}


package wasi:cli@0.2.0 {
  interface environment {
    get-environment: func() -> list<tuple<string, string>>;

    get-arguments: func() -> list<string>;

